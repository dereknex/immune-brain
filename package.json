    "plugins/immune-brain/runtime/bootstrap.ts",
    "plugins/immune-brain/runtime/bootstrap-templates",
    "plugins/immune-brain/runtime/verification_descriptor.ts",
    "plugins/immune-brain/runtime/role_prompt_bridge.ts",
