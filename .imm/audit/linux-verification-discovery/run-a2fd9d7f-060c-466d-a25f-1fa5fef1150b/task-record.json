    {
      "id": "review-f922aadd5e39-1-review-1",
      "kind": "blocking",
      "status": "refuted",
      "acceptance_id": "A1",
      "source": "review",
      "review_round": 6,
      "summary": "plugins/immune-brain/runtime/assurance/verification.ts:156-158 and 198-199 treat an unreadable environ as a non-candidate, so cleanup can be reported successful while a token-carrying descendant is still alive: on Linux a descendant that leaves the session and calls prctl(PR_SET_DUMPABLE, 0) keeps the inherited token yet cannot be read by a same-uid unprivileged host, and the current code skips it silently so killTree can still return true. Keep independently verifiable descendant attribution and return VerificationCleanupError when such a descendant cannot be confirmed exited; add a test for an independent-session descendant with an unreadable environ and resync the generated bundle.",
      "anchor": "sha256:c7be8534748f5972514ab17e8606770811b0f2dd052db95d7c8837a802754f3a",
      "evidence": {
        "trigger": "A project command on an unprivileged Linux host spawns a detached descendant; the descendant keeps IMM_VERIFICATION_PROCESS_TOKEN, calls prctl(PR_SET_DUMPABLE, 0), closes its inherited pipes and keeps running while the parent command exits 0. Its stat remains readable and its session differs from the direct child pid, but reading its environ returns EACCES.",
        "caller_chain": [
          "plugins/immune-brain/runtime/assurance/verification.ts:runFixedVerification",
          "plugins/immune-brain/runtime/assurance/verification.ts:finish",
          "plugins/immune-brain/runtime/assurance/verification.ts:killTree",
          "plugins/immune-brain/runtime/assurance/verification.ts:scanTokenPids",
          "plugins/immune-brain/runtime/assurance/verification.ts:procEnviron"
        ],
        "violated": {
          "kind": "security_boundary",
          "ref": "verification-process-cleanup-before-success"
        }
      },
      "counterevidence": {
        "attestation_id": "approval-qa-337ea5a0",
        "acceptance_id": "A1"
      }
