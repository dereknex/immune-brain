  "intent_snapshot": {
    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "2026-09-05-007-unattended-contracts-and-constitution",
    "goal": "Land the contract and constitution changes that make unattended batch runs a declared capability rather than undocumented behavior, as required by docs/specs/unattended-initiative-batch-run.spec.md sections 3.6 and 7: an explicit opt-in imm-loop parameter that leaves default behavior unchanged, amended IMMUNE.md authority text, CONTEXT.md vocabulary and Architecture Map entries, an ADR recording the reopened decision, and a synchronized dist copy, with every statement bound to shipped behavior.",
    "acceptance": [
      {
        "id": "acc-unattended-contract-text",
        "assertion": "The imm-loop Skill source and its dist copy document an explicit opt-in unattended batch parameter and state that omitting it leaves imm-loop behavior byte-identical to today, that the parameter authorizes only a user-confirmed batch of already-planned child TaskIntents, that critical children are never batched, and that the runner never pushes, opens a pull request, resolves a user decision, or creates, switches, or deletes a Git worktree. IMMUNE.md is amended so that a Batch Authorization is described as one literal-user Enrollment act covering a confirmed ordered child list, preserving the rule that no agent may promote a candidate to authority. CONTEXT.md adds the canonical terms Batch Authorization, batch plan, plan_digest, HEAD lineage, and batch branch, and its Architecture Map lists runtime/unattended and runtime/kernel/batch_authority.ts as the sole owners of batch state transitions. docs/adr/0005-unattended-initiative-batch-run.md records the reopened successor-authority decision, the evidence that TaskRecord v4 supplies identity, atomicity, and recovery, and the deferred cron, headless, CI, and multi-worktree items. No contract sentence asserts behavior the shipped slices do not implement.",
        "verification": "{\"contract\":\"assurance_kernel/verification_descriptor/v1\",\"runner_id\":\"bun\",\"runner_version\":\"1.3.14\",\"argv\":[\"test\",\"tests/unattended-contracts.test.ts\"],\"cwd\":\".\",\"timeout_ms\":120000,\"max_output_bytes\":65536}"
      },
      {
        "id": "acc-dist-sync-and-regression",
        "assertion": "Every edited Skill source and its dist counterpart stay byte-consistent under the existing dist sync guard, and the packaging and manifest checks it owns pass. The focused suites covering every edited surface of this task pass under the Kernel's bounded deterministic QA, no previously passing test in those suites is disabled, skipped, or weakened, and no third-party or regression surface is traded away. The full regression suite plus packaging and manifest checks remain the release gate `bun run verify:release`, whose full output exceeds the Kernel's fixed QA output bound, so CI enforces it on the pull request instead of a descriptor. The bound active Spec docs/specs/unattended-initiative-batch-run.spec.md is archived byte-preserving to docs/specs/archive/unattended-initiative-batch-run.spec.md by the Kernel at freeze.",
        "verification": "{\"contract\":\"assurance_kernel/verification_descriptor/v1\",\"runner_id\":\"bun\",\"runner_version\":\"1.3.14\",\"argv\":[\"test\",\"tests/unattended-contracts.test.ts\",\"tests/dist-docs-sync-contract.test.ts\",\"tests/claude-host-package.test.ts\",\"tests/pi-canary-package-boundary.test.ts\",\"tests/post-freeze-intent-resolution.test.ts\",\"tests/pi-canary-work-extension.test.ts\",\"tests/pi-canary-user-authority.test.ts\",\"tests/pi-batch-authority.test.ts\",\"tests/dual-host-assurance-conformance.test.ts\"],\"cwd\":\".\",\"timeout_ms\":300000,\"max_output_bytes\":262144}"
      }
    ],
