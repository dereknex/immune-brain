    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "retire-drained-v4-cli-surface",
    "goal": "Physically delete every CLI command marked \"Retired after v4 storage retirement\" (bin/ wrappers and the runtime's per-command diagnostic wall) so a retired name falls through to the generic unknown-command response instead of a special-cased drain_required/v3_storage_retired diagnostic.",
    "acceptance": [
      {
        "id": "AC1",
        "assertion": "The eight bin/ wrapper files for retired commands (imm-work, imm-review, imm-autowork, imm-heal, imm-migrate, imm-finish, imm-check-child-output, imm-retire-stale-wrapper) and the shared imm-retired script are absent, and invoking a retired name through the runtime CLI returns the same generic 'Unknown Immune-Brain v4 command' response as any name that never existed.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/host-runtime-cutover.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 60000,\n    \"max_output_bytes\": 65536\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      },
      {
        "id": "AC2",
        "assertion": "RETIRED_MUTATING_COMMANDS, retiredResponse, its dispatch branch, and the list-commands --json manifest's retired field are removed from runtime/v4_runtime.ts; no test asserts the deleted per-command diagnostic as current behavior.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/wrapper-retirement.test.ts\",\n      \"tests/v4-runtime-launchers.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 120000,\n    \"max_output_bytes\": 131072\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      },
      {
        "id": "AC3",
        "assertion": "README.md no longer documents any of the eight retired command names as a present-but-retired CLI table row, and the packaged imm-loop contract check remains unaffected.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/loop-contract-v4-alignment.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 60000,\n    \"max_output_bytes\": 65536\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
