    "task_id": "lane-executor-status-guidance",
    "goal": "A Lane Executor's `status` presents plugin skew as expected and non-blocking inside a Lane and tells a freshly enrolled task to implement before advancing assurance, so Lane Executors stop halting without writing code (Spec branch-boundary-r2-followups D7, D8).",
    "acceptance": [
      {
        "id": "AC1",
        "assertion": "`status` in a Lane worktree under the Git common directory's `imm/worktrees/` with a differing loaded build reports `loaded_plugin_differs_from_workspace` with a message saying the skew is expected in a Lane, does not block and needs no reload; outside a Lane the message keeps its reload instruction, and batch start still refuses on coordinator-side skew.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/claude-bundle-staleness.test.ts\",\n      \"tests/lane-executor-status-guidance.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 300000,\n    \"max_output_bytes\": 131072\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      },
