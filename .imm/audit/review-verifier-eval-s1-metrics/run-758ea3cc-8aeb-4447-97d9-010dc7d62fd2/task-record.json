  "intent_snapshot": {
    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "review-verifier-eval-s1-metrics",
    "goal": "Score reviewer configurations against the eval corpus with an offline runner, record the baseline of the current single-reviewer pipeline, publish a record-based review-quality report, record per-round review timestamps so review duration is measurable, record reviewer model identity at submission so quality metrics break down by model, and add session-visible quality metrics to the imm-retro analyzer within its existing counting rules and boundary.",
    "acceptance": [
      {
        "id": "RVE-S1-A1",
        "assertion": "Meet S1 in docs/specs/review-verifier-eval.spec.md: the runner scores a reviewer configuration per gold case (recall over confirmed_true by anchor or location; FPs on clean cases or confirmed_false matches; unknown anchors as new-anchor rate; unlabeled cases never in a denominator); a baseline run is committed under benchmark-results/review-eval with its numbers in the corpus README; the record report computes, from committed audit records only, rounds-to-pass median and p95, the resolved/refuted/accepted_risk mix, the security_boundary share of blocking findings, and advisory count per pass; the imm-retro analyzer additionally reports per author model the blocking split by violated.kind and refute/resolve/accept-residual-risk counts only where a committed fixture proves visibility; a fixture without violated.kind leaves the report unchanged; the merge gate is written down: recall not lower, clean-case FP rate not higher, rounds-to-pass p95 not higher, recall wins ties. It also carries the Jev supplement (spec item 6): a security_boundary mislabel rate from offline classification of violated.kind, experimental until scored on S0 gold, never changing a finding, record, or admission. It also carries the per-acceptance repeat-count series (spec item 7): per acceptance ID, rework findings across rounds and rounds since last finding, from committed records only; it decides nothing. It also carries the review timing instrumentation (spec item 8): per round the coordinator records reservation-creation and verdict-submission timestamps, and the report publishes dispatch-to-verdict median and p95 from rounds carrying both; pre-change records unmeasured, never zero; nothing gates on them. It also carries the per-model breakdown (spec item 9): the coordinator records the reviewer model the host reports at submission on the review history, and the report breaks recall, FP rate, and rounds-to-pass by model; model-less records are excluded from the per-model series.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/review-eval-runner.test.ts\",\n      \"tests/review-retro-analyzer.test.ts\",\n      \"tests/host-neutral-assurance-coordinator.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 180000,\n    \"max_output_bytes\": 196608\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      }
    ],
