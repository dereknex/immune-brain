        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.4.2\",\n  \"argv\": [\n    \"run\",\n    \"typecheck\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 180000,\n  \"max_output_bytes\": 20000\n}\n"
      },
      {
        "id": "ISL-2",
        "assertion": "Every test removed in this change either protected a behavior that no longer exists or names the surviving test that still covers it; no assertion about a retained behavior is deleted, skipped, or weakened, and the remaining suite passes.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.4.2\",\n  \"argv\": [\n    \"test\",\n    \"tests/v3-island-deletion.test.ts\",\n    \"tests/kernel-canary-eligibility.test.ts\",\n    \"tests/enrollment-confirmation-relocation.test.ts\",\n    \"tests/pi-canary-enroll-extension.test.ts\",\n    \"tests/imm-core-barrel-retirement.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 20000\n}\n"
      },
