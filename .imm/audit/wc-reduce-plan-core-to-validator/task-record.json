        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.4.2\",\n  \"argv\": [\n    \"test\",\n    \"tests/plan-validation.test.ts\",\n    \"tests/v3-island-deletion.test.ts\",\n    \"tests/partially-live-runtime-trim.test.ts\",\n    \"tests/imm-core-barrel-retirement.test.ts\",\n    \"tests/retention-policy-consistency.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 20000\n}\n"
