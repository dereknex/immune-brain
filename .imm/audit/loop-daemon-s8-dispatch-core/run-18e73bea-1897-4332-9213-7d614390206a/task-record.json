    {
      "id": "approval-review-54360804",
      "kind": "review",
      "authority_role": "reviewer",
      "task_revision": 1,
      "intent_content_hash": "sha256:63b4a5c79944a0980b7e914d27feca212832ddc6ae1cb7fd22936776f55687cb",
      "diff_hash": "sha256:b96b1682033424a70f6af50dbff209cd70cc2c3d7137424ff83b0a74b2a7026b",
      "actor_id": "cli:claude-code:53844238-faaa-4a7f-a915-db63b529deb0",
      "summary": "Provenance verified (686cfb265c tree 7a4f40a971, sole parent b0dd519cd0). S8-AC1: the tick fills GuardFacts from config, the gh login and local state, admits non-noop handlers only through scheduleLoopWork plus acquireLoopLease, runs the deterministic handlers through one LoopGitHubPort, records agent-backed handlers as agent_port_unavailable, and appends 0600 dispatch rows. S8-AC2: off mode, owner-identity and unreadable-login cases refuse before any write; observe records skipped_mode; dry-run and status work in every mode; interval_seconds is used unless --interval overrides it; a lease overlap is recorded held. Tests cover each. Blast radius: tier high; load-bearing paths are cli.ts tick/run, dispatch.ts GitHub writes, the guards.ts G8 revision lookup and scheduler.ts admission.",
      "acceptance_results": [],
      "review_revision": {
        "contract": "assurance_kernel/review_revision_identity/v1",
        "base_head": "b0dd519cd0903a5c8b1ddafe5b31ccdc549c21c5",
        "review_commit": "686cfb265c27cfff36e0b43504c88e0f89e287b7",
        "review_tree": "7a4f40a97141f27c781d341b4d9afc29df4f1995",
        "manifest_digest": "sha256:c5ae8fab3fcba209137cb7cb966c5c40dcced7b5a2a24a2be51ff407b5b63b04"
      },
      "advisory_findings": [
        {
          "id": "review-2e46c08df343-1-review-1",
          "acceptance_id": "S8-AC1",
          "summary": "Owner retry and ignore are recorded as 'executed' but change no state, while D10 item 5 calls them state mutations. In production, retry resolves to repair_pr_ci, so the noop retry branch is reachable only from hand-built test decisions.",
          "anchor": "sha256:3f2fe170b39c8276791ba592cb9ba60e07362fe1c1f7b7d5abe3e71990032b73",
          "evidence": {
            "trigger": "A verified '@imm-loop ignore' comment produces a dispatch row with outcome executed and detail 'ignored by owner command', but nothing is persisted, so a later tick treats the target exactly as before",
            "caller_chain": [
              "plugins/immune-brain/runtime/loop_daemon/cli.ts:runLoopDaemonCli",
              "plugins/immune-brain/runtime/loop_daemon/dispatch.ts:dispatchDecisions",
              "plugins/immune-brain/runtime/loop_daemon/owner_commands.ts:resolveOwnerCommand"
            ],
            "violated": {
              "kind": "acceptance",
              "ref": "S8-AC1"
            }
          }
        },
        {
          "id": "review-2e46c08df343-2-review-2",
          "acceptance_id": "S8-AC1",
          "summary": "A failed status Issue create or edit is silently swallowed: nothing is written to dispatches.jsonl or stderr.",
          "anchor": "sha256:b29e1cac461fb78b0a45b4c4c78d9c8f151b66d49039d20485f14430462d9a81",
          "evidence": {
            "trigger": "gitHubPort.createIssue or editIssue throws (for example a gh auth or rate-limit error) → the empty catch drops it, and the tick reports success with no record that the status update failed",
            "caller_chain": [
              "plugins/immune-brain/runtime/loop_daemon/dispatch.ts:dispatchDecisions",
              "plugins/immune-brain/runtime/loop_daemon/status_issue.ts:planStatusIssue",
              "plugins/immune-brain/runtime/loop_daemon/github_port.ts:createLoopGitHubPort"
            ],
            "violated": {
              "kind": "acceptance",
              "ref": "S8-AC1"
            }
          }
        },
        {
          "id": "review-2e46c08df343-3-review-3",
          "acceptance_id": "S8-AC1",
          "summary": "The status Issue lookup depends on the observer's 100-issue limit, and the issue is created without a label. Once more than 100 newer issues push it out of the snapshot, the daemon creates a duplicate status Issue instead of editing the existing one.",
          "anchor": "sha256:66915a21a76f2e7d8c3188b5e595748ce9befad3303e04a211c5a35cc703d19a",
          "evidence": {
            "trigger": "A repository with more than 100 issues newer than the status Issue → snapshot.issues lacks the marker issue → planStatusIssue returns create → a second 'Loop daemon status' issue is opened",
            "caller_chain": [
              "plugins/immune-brain/runtime/loop_daemon/observer.ts:pollIssuesFromGithub",
              "plugins/immune-brain/runtime/loop_daemon/dispatch.ts:dispatchDecisions",
              "plugins/immune-brain/runtime/loop_daemon/github_port.ts:createIssue"
            ],
            "violated": {
              "kind": "acceptance",
              "ref": "S8-AC1"
            }
          }
        },
        {
          "id": "review-2e46c08df343-4-review-4",
          "acceptance_id": "S8-AC2",
          "summary": "The owner-identity refusal compares logins case-sensitively. The live tick and run refusal tests also inject guardFacts.daemon_identity rather than reading the login from 'gh api user'; only the unreadable-login test goes through that real seam.",
          "anchor": "sha256:e0fdb3376b3c2efada0025e521f0cc646c2dae4061d79a0b50b7ba145adc898e",
          "evidence": {
            "trigger": "loop.allowed_actors contains 'Daemon-Bot' and gh api user returns 'daemon-bot' → includes() is false → the live tick proceeds instead of refusing",
            "caller_chain": [
              "plugins/immune-brain/runtime/loop_daemon/cli.ts:runLoopDaemonCli",
              "plugins/immune-brain/runtime/loop_daemon/identity.ts:readAuthenticatedGithubLogin"
            ],
            "violated": {
              "kind": "acceptance",
              "ref": "S8-AC2"
            }
          }
        }
      ],
      "reviewer_verdict_sha256": "sha256:45856d6160cd27ab76d5b316924dbdf46870f2615d3876bcf3b68b0ba9e8e15f"
    }
  ],
