  "findings": [
    {
      "id": "review-fd5a6b8411a0-1-review-1",
      "kind": "blocking",
      "status": "resolved",
      "acceptance_id": "S10-AC2",
      "source": "review",
      "review_round": 1,
      "summary": "readCommits passes --diff-filter=A to git log, which drops every commit that adds no file, so fix/repair commits that only modify files are never counted and the committed baseline undercounts escapes.",
      "anchor": "sha256:04a7b3c4ae5623259f3d9534a4a9f3fc17f7a49f7d5c0900c6514aae1138111a",
      "evidence": {
        "trigger": "A fix commit inside a tag's 7-day window that only modifies existing files (e.g. d979c219c75 'fix(no-touch): retire the docs/agents/no-touch.json declaration', 2026-11-22, inside the v9.1.0 window closing 2026-11-24) -> git log --no-merges --diff-filter=A omits it (verified: the filtered listing skips d979c219c75 while the unfiltered listing includes it), so buildReport never sees it and v9.1.0 reports 1 fix commit instead of at least 2; docs/evidence/release-escape-baseline.md records this undercount. The git-reader test only makes commits that add new paths, so it cannot catch the omission. Fix: read added changesets separately (or drop --diff-filter from commit selection) and add a test with a modify-only fix commit.",
        "caller_chain": [
          "scripts/release-escape-report.ts:import.meta.main",
          "scripts/release-escape-report.ts:readCommits",
          "scripts/release-escape-report.ts:buildReport",
          "tests/release-escape-report.test.ts:git readers",
          "docs/evidence/release-escape-baseline.md"
        ],
        "violated": {
          "kind": "acceptance",
          "ref": "S10-AC2"
        }
      },
      "counterevidence": null
    },
    {
      "id": "review-bcb249d72c75-1-review-1",
      "kind": "blocking",
      "status": "resolved",
      "acceptance_id": "S10-AC1",
      "source": "review",
      "review_round": 2,
      "summary": "The workflow's bump step pipes the script into tee without pipefail, so the script's exit 1 on a registry failure or pre-release 'latest' is swallowed and the weekly job reports success with no PR (unknown-error suppression / fabricated success). Fix: set shell: bash or 'set -o pipefail', and add a workflow-contract test that pins it.",
      "anchor": "sha256:7ea95bfee7ff2da8493925de7f0bacb4e9ee5ec88f1b37eb8b9fae5ac0416f3a",
      "evidence": {
        "trigger": "Weekly run where registryLookup throws (HTTP error, or a latest dist-tag like 2.2.0-beta.1 makes compareVersions throw) → scripts/bump-e2e-hosts.ts exits 1, but step 'Bump tests/e2e/hosts.json' runs `bun scripts/bump-e2e-hosts.ts | tee bump.log` under the GitHub default `bash -e {0}` with no pipefail, so the pipeline status is tee's 0. git diff --quiet then sees no change, changed=false, every later step is skipped and the job finishes green: the bump silently never happened and no failure is visible. tests/e2e-host-bump.test.ts 'e2e-host-bump workflow' does not assert that the bump failure propagates.",
        "caller_chain": [
          ".github/workflows/e2e-host-bump.yml#jobs.bump.steps[Bump tests/e2e/hosts.json]",
          "scripts/bump-e2e-hosts.ts#import.meta.main",
          "scripts/bump-e2e-hosts.ts#run",
          "scripts/bump-e2e-hosts.ts#registryLookup"
        ],
        "violated": {
          "kind": "acceptance",
          "ref": "S10-AC1"
        }
      },
      "counterevidence": null
    }
  ],
