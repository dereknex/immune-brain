  "intent_snapshot": {
    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "2026-09-01-001-shared-assurance-host-boundary",
    "goal": "Extract the narrow host-neutral Enrollment and Assurance coordination boundary defined by docs/specs/dual-host-assurance.spec.md, exercise it through a fake Host and the real Pi adapter, and preserve Pi preparation identifiers and digests, persisted authority bytes, public Tool result contracts, foreground cancellation linearization, Review receipt ordering, and settlement behavior.",
    "acceptance": [
      {
        "id": "acc-host-port",
        "assertion": "A fake non-Pi Host drives routine, material, and critical progression through the shared Assurance coordinator, while missing, stale, replayed, wrong-task, wrong-revision, or incomplete Review and user authority evidence fails before Kernel mutation and shared modules import no Host SDK or adapter.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/host-neutral-assurance-coordinator.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 60000,\n  \"max_output_bytes\": 65536\n}\n"
      },
      {
        "id": "acc-pi-assurance",
        "assertion": "The real Pi adapter preserves deterministic QA, routine completion, immutable material and critical Review preparation, exact native receipt correlation and event ordering, freshness rejection, retryable post-QA Review preparation, rework, precommit cancellation, and postcommit settlement-unknown semantics while delegating host-neutral sequencing to the shared boundary.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-assurance-progression.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 90000,\n  \"max_output_bytes\": 65536\n}\n"
      },
      {
        "id": "acc-pi-enrollment",
        "assertion": "Pi Enrollment keeps the existing preparation contract identifier and digest, exact TaskIntent binding, TUI-only literal-user gate, zero-write rejection and cancellation behavior, opaque capability consumption, and atomic v4 Enrollment transaction through the shared Enrollment boundary.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-enroll-extension.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 65536\n}\n"
      },
      {
        "id": "acc-package-boundary",
        "assertion": "The accepted dual-Host ADR supersedes only ADR-0002's Pi-only assumption, the root package ships the host-neutral Assurance modules required by the unchanged Pi extension, compatibility re-exports remain bounded with an exit milestone, and Kernel/shared modules do not import Pi or Claude adapter APIs or a generic registry/dispatcher.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-package-boundary.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 60000,\n  \"max_output_bytes\": 65536\n}\n"
      }
    ],
