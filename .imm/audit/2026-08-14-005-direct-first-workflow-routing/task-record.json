  "intent_snapshot": {
    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "2026-08-14-005-direct-first-workflow-routing",
    "goal": "Make Direct Path the default for eligible low-risk work through one ordered ownership and risk matrix, while preserving fail-closed Managed routing for active workflow ownership and material risk without adding persisted route state or weakening Managed authority.",
    "acceptance": [
      {
        "id": "acc-direct-default",
        "assertion": "Eligible work defaults to Direct by absence of Managed triggers; file count, local verifier count, ordinary retries, optional read-only advice, and unrelated dirty files do not independently escalate it, and route selection writes no workflow state.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/direct-first-routing-contract.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 131072\n}\n"
      },
      {
        "id": "acc-managed-risk-boundary",
        "assertion": "Existing Managed ownership, explicit Managed intent, security, public compatibility or schema, concurrency or recovery, release or external writes, destructive or irreversible effects, multi-owner coordination, and unresolved material uncertainty route fail-closed to Managed and cannot be downgraded by Direct wording.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/direct-first-routing-contract.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 131072\n}\n"
      },
      {
        "id": "acc-direct-completion-confirmation",
        "assertion": "Direct completion requires passing task-scoped verification, a stable task-owned diff, and zero task-owned unresolved failures without requiring whole-worktree cleanliness; confirmations are reserved for privileged or irreversible effects and exact task-owned local commits need no extra workflow confirmation.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/direct-first-routing-contract.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 131072\n}\n"
      },
      {
        "id": "acc-consumer-contracts",
        "assertion": "Canonical and generated BASELINE copies, initialization templates and ready_for output, user and planner guidance, and behavior fixtures consistently expose Direct first while retaining Managed entrypoints and a hard-risk boundary scenario.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/direct-first-routing-contract.test.ts\",\n    \"plugins/immune-brain/tests/init-project.test.ts\",\n    \"tests/baseline-packaging-contract.test.ts\",\n    \"tests/immune-brain-behavior-eval-contract.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 131072\n}\n"
      },
      {
        "id": "acc-regression-suite",
        "assertion": "The complete repository test suite and generated documentation synchronization checks pass after the routing change.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 300000,\n  \"max_output_bytes\": 262144\n}\n"
