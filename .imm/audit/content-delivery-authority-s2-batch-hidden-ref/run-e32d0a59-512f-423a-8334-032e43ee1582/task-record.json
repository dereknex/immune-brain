      "advisory_findings": [
        {
          "id": "review-d6f4a3c78382-1-review-1",
          "acceptance_id": "S2-AC2",
          "summary": "commitAppliedDelta swallows every error, including unexpected ones, when committing an applied Lane delta under Git integration auto. Delivery is unaffected, but the failure is silent. Consider recording the refusal in the batch report.",
