        "id": "AC1",
        "assertion": "Source: user repair request and observeNativeParent in runtime/unattended/batch_git.ts. At tests/unattended-batch-commit.test.ts, a delivered-only Parent with superseded batch history reaches native integration and final verification, preserving retired bytes and prior commits. Absent, declined or cancelled native confirmation has no commit/command effect; exit 7 keeps Parent incomplete; successful proof binds integrated HEAD and replay makes no duplicate commit. Active batches and effective completed batches retain their existing route; missing delivery or changed identity is not accepted.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/unattended-batch-commit.test.ts\",\n      \"tests/goal-driven-batch-run.test.ts\",\n      \"tests/batch-plan-reconfirmation.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 300000,\n    \"max_output_bytes\": 196608\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
