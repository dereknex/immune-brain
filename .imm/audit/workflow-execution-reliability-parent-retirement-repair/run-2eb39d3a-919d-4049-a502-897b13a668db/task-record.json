  "findings": [
    {
      "id": "review-ddf9226e0267-1-review-1",
      "kind": "blocking",
      "status": "resolved",
      "acceptance_id": "AC1",
      "source": "review",
      "review_round": 1,
      "summary": "Native-effect authorization gap: batch_git.ts:930-934 now routes superseded history into advanceNativeParent, but its confirmation guard at line 990 requires nonempty commands. With omitted or empty final_verification, lines 1005-1009 commit settled deliveries without invoking the native gate. The unchanged direct caller kernel_ports.ts:869-872 was inspected to trace this route: it forwards optional final_verification and relies on that gate to reject reuse-only execution. Require confirmation before previously unauthorized integration independently of whether final commands exist, and extend tests/unattended-batch-commit.test.ts to cover omitted and empty commands with absent, declined, and cancelled confirmation.",
      "anchor": "sha256:7cf3eefe73981a8ac03131f6980e88ee5e6b8b963cb68bc0e384f5a257473c2f",
      "evidence": {
        "trigger": "A delivered-only Parent has superseded batch history, an uncommitted settled delivery, and no native final report; start_unattended_batch omits final_verification or supplies [] → advanceNativeParent skips the confirmation callback and creates a Git commit, including on a reuse-only continuation that must not open a gate.",
        "caller_chain": [
          "plugins/immune-brain/runtime/claude/kernel_ports.ts:startPreparedBatch",
          "plugins/immune-brain/runtime/unattended/batch_git.ts:observeNativeParent",
          "plugins/immune-brain/runtime/unattended/batch_git.ts:advanceNativeParent",
          "plugins/immune-brain/runtime/unattended/batch_git.ts:commitBatchChild"
        ],
        "violated": {
          "kind": "acceptance",
          "ref": "AC1"
        }
      },
      "counterevidence": null
    },
    {
      "id": "review-15252b19bcea-1-review-1",
      "kind": "blocking",
      "status": "resolved",
      "acceptance_id": "AC1",
      "source": "review",
      "review_round": 2,
      "summary": "plugins/immune-brain/runtime/unattended/batch_git.ts:993–1008：部分 delivery 尚未 settled 时，runsNow 为 false 会跳过 native confirmation，但后续仍提交已 settled 的 delivery。应将 integration 的确认与能否立即运行 final verification 分开，任何 integration commit 前都必须取得确认；补充 superseded history 下一个已 settled task 加一个尚未 settled critical task 的无 gate、declined、cancelled 回归测试，并同步生成 dist。",
      "anchor": "sha256:099322d0918e9fa0d6507c4c0c98ad42bc3478209efea68988e490d5c90a8416",
      "evidence": {
        "trigger": "可信 workspace 中，Parent 有 superseded batch history、已 settled done 但尚未 integrated 的 task A，以及尚未 settled 的 critical task B，工作区变化均属于 A → observeNativeParent 返回 integrate，missing_task_ids 为 [A, B] 而 integrateIds 为 [A]，missing.every(...) 为 false，因此完全不调用 gate；随后 integration 循环调用 commitBatchChild 提交 A，即使 gate 缺失或本应拒绝、取消，也已经改变 Git HEAD，违反无确认不得产生 commit effect 的 invariant。",
        "caller_chain": [
          "plugins/immune-brain/runtime/unattended/batch_git.ts:observeNativeParent",
          "plugins/immune-brain/runtime/unattended/batch_git.ts:advanceNativeParent",
          "plugins/immune-brain/runtime/unattended/batch_git.ts:commitBatchChild"
        ],
        "violated": {
          "kind": "security_boundary",
          "ref": "native confirmation before Parent delivery integration commits"
        }
      },
      "counterevidence": null
    }
  ],
