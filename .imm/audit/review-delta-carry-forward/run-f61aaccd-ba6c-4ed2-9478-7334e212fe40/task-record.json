    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "review-delta-carry-forward",
    "goal": "A delta Review round (round 3 or later with computed delta_paths) tells the reviewer that changed paths outside delta_paths were inspected by earlier rounds at the prior reviewed commit and are attested in approval.inspected_paths by carry-forward rather than re-read, and that an unread or truncated path is not a defect and never a blocking finding, so a wide change such as branch-boundary-r2 S4 serial-runner-retirement (29 paths, -12303 lines) no longer blocks on a coverage-only finding that names no defect.",
    "acceptance": [
      {
        "id": "AC1",
        "assertion": "The Review prompt for a round with computed delta_paths states that changed paths outside delta_paths are attested in approval.inspected_paths by carry-forward from the prior reviewed commit without re-reading their full diff, and that incomplete reading is not a defect and never a blocking finding.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/host-neutral-assurance-coordinator.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 300000,\n    \"max_output_bytes\": 131072\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      },
      {
        "id": "AC2",
        "assertion": "The Review prompt for rounds 1 and 2 and for a skipped delta carries none of the carry-forward text, and verdict validation is unchanged: a pass still lists every changed path in approval.inspected_paths and an out-of-delta blocking finding is still rejected.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/host-neutral-assurance-coordinator.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 300000,\n    \"max_output_bytes\": 131072\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      },
      {
        "id": "AC3",
