      "evidence": {
        "trigger": "markPrReady called with a daemon PR carrying an unresolved review { state: \"CHANGES_REQUESTED\" } in pr.reviews, checks: [], conclusion: \"startup_failure\", or draft: false (cited alongside plugins/immune-brain/runtime/loop_daemon/events.ts E11 ready emission in the same state machine, which does not filter pr.reviews or draft) → markPrReady ignores pr.reviews, empty/startup_failure checks, and draft/state, calling deps.markReady and returning action: \"marked_ready\" despite failing D8.2 check and review gates.",
        "caller_chain": [
