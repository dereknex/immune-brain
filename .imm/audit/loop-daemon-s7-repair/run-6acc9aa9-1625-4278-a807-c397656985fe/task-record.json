      "evidence": {
        "trigger": "closeOut called with an unmerged PR (state: \"open\", merged: false, as in tests/loop-daemon-repair.test.ts Suite 8) or with a missing lease / failing rmSync → closeOut deletes the active worktree and lease on an unmerged PR, swallows rmSync failures via catch {}, unconditionally reports released_lease: true even when plugins/immune-brain/runtime/loop_daemon/state.ts deleteLease returns false, and leaves state.json active_leases (read by plugins/immune-brain/runtime/loop_daemon/cli.ts and guards.ts in the same lease state machine) uncleaned.",
        "caller_chain": [
          "plugins/immune-brain/runtime/loop_daemon/repair_agent.ts",
          "dispatchRepair",
          "closeOut"
        ],
        "violated": {
          "kind": "acceptance",
          "ref": "S7-AC1"
        }
      },
      "counterevidence": null
    },
