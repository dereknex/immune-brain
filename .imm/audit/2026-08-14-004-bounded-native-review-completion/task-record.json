    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "2026-08-14-004-bounded-native-review-completion",
    "goal": "Make native Assurance Review reliably finish within one auditable 300-second total budget, with a bounded immutable-bundle prompt and exactly one terminal outcome, so near-complete reviewers are not repeatedly timed out without weakening reviewer authority or adding automatic retries.",
    "acceptance": [
      {
        "id": "acc-review-deadline-consistent",
        "assertion": "Every native Review operation uses one 300-second total deadline measured from initial dispatch, retains the existing 5-second spawn sub-budget and 12-turn cap, and projects the same deadline through advance results, Footer, Widget, timeout notification, and correlated terminal follow-up.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-work-extension.test.ts\",\n    \"tests/pi-canary-assurance-observability.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 240000,\n  \"max_output_bytes\": 262144\n}\n"
      },
      {
        "id": "acc-review-prompt-bounded",
        "assertion": "The native Review prompt requires immutable-bundle provenance first, limits analysis to acceptance assertions and immutable dirty-file contents, discourages unrelated repository exploration, reserves the final turn for exactly one strict JSON verdict, and still spawns with maxTurns 12.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-work-extension.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 240000,\n  \"max_output_bytes\": 262144\n}\n"
      },
      {
        "id": "acc-review-single-terminal-winner",
        "assertion": "Completion before timeout, timeout before completion, same-tick completion/timeout, explicit cancellation, and late terminal settlement each produce at most one winning terminal lifecycle and one correlated follow-up; timeout/cancel/partial/late output creates no pending verdict or Kernel write, and duplicate advance never spawns a second reviewer while ownership is unsettled.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-work-extension.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 240000,\n  \"max_output_bytes\": 262144\n}\n"
      },
      {
        "id": "acc-review-budget-contract-regression",
        "assertion": "Source and packaged Review dispatch contracts document the 300-second bounded ceiling, no automatic retry, one reviewer per immutable snapshot, settlement ownership, and unavailable fine-grained telemetry truthfully; all repository tests and generated-doc synchronization remain clean with no active 180-second Review contract.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 300000,\n  \"max_output_bytes\": 262144\n}\n"
      }
    ],
