  "intent_snapshot": {
    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "implicit-scope-topological-order",
    "goal": "Implicit scope dependencies between overlapping batch children follow a topological order of the declared blocked_by edges, with Slice order only breaking ties, so a plan whose declared dependencies are acyclic never projects a cycle when a higher-numbered Slice (such as branch-boundary-r2 S10) is a declared prerequisite of lower-numbered overlapping Slices; batch authorization, Lane admission and parked-child skipping keep using the same edges.",
    "acceptance": [
      {
        "id": "AC1",
        "assertion": "projectParallelGroups and startableChildren accept a plan whose declared blocked_by edges are acyclic but whose Slice order disagrees with them: children S2 (blocked_by S10), S3 (blocked_by S2, S10), S4 (no declared dependency) and S10 (no declared dependency), all with overlapping scope_hint, project the waves [S4], [S10], [S2], [S3] without throwing, and every implicit edge points from a child placed earlier in that order to one placed later.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/unattended-batch-schedule.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 300000,\n    \"max_output_bytes\": 131072\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      },
      {
        "id": "AC2",
        "assertion": "When declared dependencies leave two overlapping children unordered, the lower Slice still runs first (a child without slice_id keeps its list position); a declared dependency cycle is still rejected with the acyclic error; blockedByParked still skips a later overlapping child and its dependents behind a parked child.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/unattended-batch-schedule.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 300000,\n    \"max_output_bytes\": 131072\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      },
      {
        "id": "AC3",
