  "intent_snapshot": {
    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "review-budget-change-size",
    "goal": "The independent Review turn budget scales with the size of the change under review, not only with risk, acceptance count and evidence bytes: a Review whose evidence lists many changed paths is classified heavy and gets the heavy turn budget, so a material-risk change that touches dozens of files (such as branch-boundary-r2 S4 serial-runner-retirement, 27 paths) is no longer cut off at the standard 16 turns before the reviewer can read it.",
    "acceptance": [
      {
        "id": "AC1",
        "assertion": "classifyReviewWorkload returns heavy for a material-risk snapshot with 3 acceptance items whose evidence lists 12 or more changed paths, for both a review manifest (changed_paths) and a review bundle (dirty_files), and still returns standard for the same snapshot with 11 changed paths; the heavy budget is 24 turns.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/pi-canary-review-outcome-evidence.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 300000,\n    \"max_output_bytes\": 131072\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      },
      {
        "id": "AC2",
        "assertion": "The existing classification is otherwise unchanged: a critical snapshot or one with 9 or more acceptance items is heavy, a routine snapshot with at most 3 acceptance items, at most 5 changed paths and at most 64 KiB of evidence is quick, and reviewTurnBudget stays 12, 16 and 24 for quick, standard and heavy.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/pi-canary-review-outcome-evidence.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 300000,\n    \"max_output_bytes\": 131072\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      },
      {
        "id": "AC3",
        "assertion": "The committed Claude MCP bundle matches the runtime source.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"scripts/build-claude-plugin.ts\",\n      \"--check\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 120000,\n    \"max_output_bytes\": 131072\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      }
