  "findings": [
    {
      "id": "review-1f7d4a66342f-1-review-1",
      "kind": "blocking",
      "status": "resolved",
      "acceptance_id": "S3-AC1",
      "source": "review",
      "review_round": 1,
      "summary": "A rejected @imm-loop command, such as an edited comment or an approve with no digest, is not kept out of the handlers. matchTier1 returns null for it, so the comment falls through to the Tier 2 a18/a19 decision model, which can map it to enroll_and_drive. At base, every @imm-loop comment was settled at Tier 1, and approve went to noop_record.",
      "anchor": "sha256:c8e5cc059a5ffa5398f4a00c03a216d3b760dccb946ca001d899a693b0e2f987",
      "evidence": {
        "trigger": "A verified owner (allowlisted login, OWNER association) posts an E3_OWNER_COMMENT with body '@imm-loop approve sha256:plan-a' and updated_at !== created_at, or posts '@imm-loop approve' with no digest. G7 passes because it checks only the actor (guards.ts:203). resolveOwnerCommand returns handler null with 'comment was edited after posting' or 'approve names no plan digest'. matchTier1 (judgement.ts, E3 case: `if (resolved.handler === null) return null`) then sends the comment to judgeTier2, and classifyOwnerComment sends the body to a19_owner_comment_intent. If a19 answers approve_plan, the result is tier 2 with handler enroll_and_drive. That breaks D3.4 / spec line 226 ('an edited comment is strictly rejected per ADR 0039 Decision 9') and the module's own contract that the caller keeps rejections out of the handler catalogue. At base a60d2429, the same comment resolved at Tier 1 to noop_record. No judgeEvent test covers an edited or digest-less command. Fix: when a command is parsed but rejected, Tier 1 should return noop_record or escalate, never null, and a judgeEvent test should pin this.",
        "caller_chain": [
          "plugins/immune-brain/runtime/loop_daemon/judgement.ts:judgeEvent",
          "plugins/immune-brain/runtime/loop_daemon/judgement.ts:matchTier1",
          "plugins/immune-brain/runtime/loop_daemon/owner_commands.ts:resolveOwnerCommand",
          "plugins/immune-brain/runtime/loop_daemon/judgement.ts:judgeTier2",
          "plugins/immune-brain/runtime/loop_daemon/judgement.ts:classifyOwnerComment"
        ],
        "violated": {
          "kind": "acceptance",
          "ref": "S3-AC1"
        }
      },
      "counterevidence": null
    }
  ],
