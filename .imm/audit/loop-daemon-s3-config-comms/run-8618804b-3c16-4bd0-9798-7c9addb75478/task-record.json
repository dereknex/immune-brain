      "advisory_findings": [
        {
          "id": "review-d977b2b24163-1-review-1",
          "acceptance_id": "S3-AC1",
          "summary": "Escalation and status-Issue lookup accept the marker from any author. A third party who copies the marker can make the daemon skip its own escalation or edit an Issue that party opened, instead of using a daemon-authored carrier.",
          "anchor": "sha256:42feea12cfc67ce50e377e9502068406447c41c1e067b319f2827423af796477",
          "evidence": {
            "trigger": "A non-daemon user comments renderEscalationBody(escalationKey({kind,target,detail}), message) using the public subject fields → planEscalation returns action skip for that comment_id, and the daemon never posts its own escalation; likewise an Issue opened before the daemon's with the loop-status marker becomes the canonical status Issue",
            "caller_chain": [
              "plugins/immune-brain/runtime/loop_daemon/escalation.ts:planEscalation",
              "plugins/immune-brain/runtime/loop_daemon/escalation.ts:parseEscalationKey",
              "plugins/immune-brain/runtime/loop_daemon/status_issue.ts:planStatusIssue",
              "plugins/immune-brain/runtime/loop_daemon/status_issue.ts:isLoopStatusIssue"
            ],
            "violated": {
              "kind": "acceptance",
              "ref": "S3-AC1"
            }
          }
        },
        {
          "id": "review-d977b2b24163-2-review-2",
          "acceptance_id": "S3-AC1",
          "summary": "The approve argument is the next token after the command, even across a newline, and nothing checks it against the published plan digest here. Binding the token to the plan is left to the later S5 record_approval step.",
          "anchor": "sha256:ed7905a7d3c984f3ffaa245c0f82c104802e84c8e32ffca849ff3bde371ad506",
          "evidence": {
            "trigger": "A verified owner comments '@imm-loop approve\\n\\nthanks' → parseOwnerCommand captures argument 'thanks', and resolveOwnerCommand accepts it and returns handler enroll_and_drive",
            "caller_chain": [
              "plugins/immune-brain/runtime/loop_daemon/owner_commands.ts:parseOwnerCommand",
              "plugins/immune-brain/runtime/loop_daemon/owner_commands.ts:resolveOwnerCommand",
              "plugins/immune-brain/runtime/loop_daemon/judgement.ts:matchTier1"
            ],
            "violated": {
              "kind": "acceptance",
              "ref": "S3-AC1"
            }
          }
        }
      ],
      "reviewer_verdict_sha256": "sha256:648691c70522dd4ef1138e34619746cbe17e65c29083d649b8b06267490642fb"
