      "evidence": {
        "trigger": "Run `imm-loop tick --dry-run` with an unlabelled E1 issue and configured a18/a15 bindings → the executable calls runLoopDaemonCli without options.classify, classifyPoint returns no_binding, and the decision is a tier-3 baseline triage_issue with no classification instead of invoking the configured decision-model points.",
        "caller_chain": [
          "plugins/immune-brain/bin/imm-loop",
