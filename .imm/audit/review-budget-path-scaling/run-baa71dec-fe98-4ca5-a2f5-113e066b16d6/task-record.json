  "intent_snapshot": {
    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "review-budget-path-scaling",
    "goal": "The heavy independent Review turn budget grows with the number of changed paths instead of stopping at a flat 24 turns: a heavy Review gets 12 turns plus one per changed path, at least 24 and at most 48, so a wide change such as branch-boundary-r2 S4 serial-runner-retirement (29 paths, -12303 lines) is no longer cut off before the reviewer has read every changed file.",
    "acceptance": [
      {
        "id": "AC1",
        "assertion": "The turn budget for a heavy Review is 12 plus the number of changed paths in its evidence, bounded below by 24 and above by 48: 12 or fewer paths give 24, 29 paths give 41, and 36 or more paths give 48, for both a review manifest (changed_paths) and a review bundle (dirty_files).",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/pi-canary-review-outcome-evidence.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 300000,\n    \"max_output_bytes\": 131072\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      },
      {
        "id": "AC2",
        "assertion": "Quick and standard Reviews keep their flat 12 and 16 turn budgets regardless of path count, and the workload classification rules (critical, 9 or more acceptance items, 12 or more changed paths or more than 512 KiB of evidence for heavy; the routine quick limits) are unchanged.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/pi-canary-review-outcome-evidence.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 300000,\n    \"max_output_bytes\": 131072\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      },
      {
        "id": "AC3",
        "assertion": "The committed Claude MCP bundle matches the runtime source.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"scripts/build-claude-plugin.ts\",\n      \"--check\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 120000,\n    \"max_output_bytes\": 131072\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      }
