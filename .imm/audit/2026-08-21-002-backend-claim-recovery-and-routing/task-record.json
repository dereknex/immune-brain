  "intent_snapshot": {
    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "2026-08-21-002-backend-claim-recovery-and-routing",
    "goal": "Make Kernel backend-claim conflicts self-routing and narrowly self-repairing without manual .imm edits or repeated Enrollment. Reconcile durable Kernel transaction markers under the store lock, classify canonical owner state once for Kernel and host adapters, route consistent foreign active claims to the incumbent task through imm-loop, and expose a native-confirmed repair_authority_state operation only for a markerless terminal claim proven redundant by matching TaskRecord, immutable tombstone, terminal phase, final record hash, and null workspace owner. Preserve fail-closed behavior for malformed or contradictory authority state, return structured next actions, and prevent unchanged blocker retries.",
    "acceptance": [
      {
        "id": "acc-kernel-owner-reconciliation",
        "assertion": "Kernel reconciliation replays valid durable transaction markers, classifies consistent active, terminal, unowned, repairable, and contradictory owner states, and leaves unsupported contradictions byte-stable.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/kernel-canary-terminal-transaction.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 180000,\n  \"max_output_bytes\": 65536\n}\n"
      },
      {
        "id": "acc-host-routing-and-repair",
        "assertion": "Enrollment and Work consume the shared owner matrix, route a consistent incumbent to imm-loop, require native confirmation for narrow stale-claim repair, and do not recommend an unchanged Enrollment retry.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-enroll-extension.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 180000,\n  \"max_output_bytes\": 65536\n}\n"
      }
    ],
