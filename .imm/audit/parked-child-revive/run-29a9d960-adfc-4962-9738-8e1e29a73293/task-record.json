    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "parked-child-revive",
    "goal": "Resuming a parked Lane batch with a fresh confirmation revives a child whose run was stopped or whose Lane is unreadable or lost in a recreated Lane at the Parent tip under a redo grant, while children that cannot be revived stay parked and independent children resume, so the batch no longer has to be retired (Spec branch-boundary-r2-followups D5).",
    "acceptance": [
      {
        "id": "AC1",
        "assertion": "On resume with a fresh literal-user confirmation, a parked child whose Lane run is terminal `stopped` gets its Lane recreated at the current Parent tip with an empty Lane store, consumes one redo grant and is enrolled fresh under the original authorization, while another parked child with a recoverable owned run resumes as before.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/batch-parked-revive.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 300000,\n    \"max_output_bytes\": 131072\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      },
      {
        "id": "AC2",
        "assertion": "A parked child whose Lane projection is unreadable (`batch_lane_unreadable`) or whose Lane path is gone (`batch_lane_lost`) is revived the same way on resume.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/batch-parked-revive.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 300000,\n    \"max_output_bytes\": 131072\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      },
      {
        "id": "AC3",
        "assertion": "A parked child with no redo grant left, or with an open user decision or replan, stays `needs_human` and its dependents stay `skipped_blocked`, while an independent parked child resumes; a resume without a fresh confirmation is still refused.",
