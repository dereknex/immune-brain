  "findings": [
    {
      "id": "review-273a813b7317-1-review-1",
      "kind": "blocking",
      "status": "resolved",
      "acceptance_id": "AC3",
      "source": "review",
      "review_round": 1,
      "summary": "[P2] 提交期间检测到 packet 被修改时仍保留 reservation。两个 Host 新增的 inspectReview 检查均返回 release:true，但 unchanged 的 review_mediation.ts:84–86 在第二次检查时只返回 reason，丢失 release；coordinator.ts:1550–1551 因而返回 blocked 和 RETAINED_REVIEW_RECOVERY，不释放 reservation。这里读取 unchanged mediation/coordinator 是为了追踪新增检查的同一提交状态机。最小修复是让提交前复检保留并处理 release 标志，释放 reservation 并返回 RELEASED_REVIEW_RECOVERY；在 dual-host seam 增加首次 inspect 成功后、projectTask 等待期间修改 packet 的确定性测试，断言本次提交释放且下一次 advance 创建新 operation。",
      "anchor": "sha256:2dd06a28f61b07fa007c830f482e0d7b2765a2a8baca16387ee8e5bf197ce32b",
      "evidence": {
        "trigger": "Pi 或 Claude reviewer 已绑定且已返回有效 verdict，submit_review 首次 inspect 通过；在 coordinator 等待 projectTask 或 ensureReviewRevision 期间修改 packet → validateReceipt 的第二次 inspect 检测 digest mismatch，但本次提交仍保留 active reservation，并错误要求等待已结束的 reviewer，而不是释放并获取新 reservation。",
        "caller_chain": [
          "plugins/immune-brain/runtime/assurance/review_mediation.ts:submitMediatedReview",
          "plugins/immune-brain/runtime/assurance/coordinator.ts:submitReviewOnce",
          "plugins/immune-brain/runtime/assurance/review_mediation.ts:options.validateReceipt",
          "plugins/immune-brain/.pi-extension/pi-canary-assurance-progression.ts:PiReviewHost.inspectReview",
          "plugins/immune-brain/runtime/claude/review_host.ts:ClaudeReviewHost.inspectReview",
          "plugins/immune-brain/runtime/assurance/coordinator.ts:1550-1551"
        ],
        "violated": {
          "kind": "acceptance",
          "ref": "AC3"
        }
      },
      "counterevidence": null
    }
  ],
