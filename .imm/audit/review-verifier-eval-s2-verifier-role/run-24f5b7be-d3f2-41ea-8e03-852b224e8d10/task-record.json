    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "review-verifier-eval-s2-verifier-role",
    "goal": "Add a read-only review-verifier role that checks each blocking finding of a rework verdict against the immutable revision and its acceptance, seeing the finding and its evidence but never the reviewer's reasoning, and returning only kept or refuted with a concrete counter-path.",
    "acceptance": [
      {
        "id": "RVE-S2-A1",
        "assertion": "Meet S2 in docs/specs/review-verifier-eval.spec.md: the verifier input packet built by the coordinator contains, per blocking finding, its id, summary, evidence, and acceptance text plus the snapshot digest and immutable revision identity, and demonstrably excludes reviewer prose beyond the finding fields, the approval summary and inspected_paths, Parent commentary, and any prior verifier output (packet snapshot assertions); the output contract assurance_kernel/review_verification/v1 is enforced so that a missing per-finding result, an unknown anchor, a refuted result without a concrete counter-path citing the revision, or any additional finding makes the whole verification malformed and keeps every finding; the verifier dispatches on a different model from the reviewer whenever the host offers one and the attestation records which case applied; the role prompt source, its dist mirrors, and the Claude reviewer definitions regenerated by the build path agree, and the role carries no stable review gate and cannot be dispatched as imm-code-review.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v2\",\n  \"command\": {\n    \"executable\": \"bun\",\n    \"argv\": [\n      \"test\",\n      \"tests/host-neutral-assurance-coordinator.test.ts\",\n      \"tests/skill-dist-consistency.test.ts\"\n    ],\n    \"cwd\": \".\",\n    \"timeout_ms\": 180000,\n    \"max_output_bytes\": 196608\n  },\n  \"environment\": {\n    \"prepare\": null,\n    \"writable_paths\": []\n  }\n}\n"
      }
    ],
