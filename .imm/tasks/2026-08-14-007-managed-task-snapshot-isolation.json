      },
      {
        "id": "acc-in-scope-drift-fails-closed",
        "assertion": "Invalid or empty scope, in-scope unstaged or untracked bytes, staged index mutation, HEAD change, root or path drift, unsupported Git object modes, and Review capture races fail before spawning Review or writing evidence or approval authority.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/managed-task-snapshot-isolation.test.ts\",\n    \"tests/pi-canary-review-bundle.test.ts\",\n    \"tests/kernel-r2c2-application.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 180000,\n  \"max_output_bytes\": 262144\n}\n"
      },
      {
        "id": "acc-assurance-chain-consistency",
        "assertion": "Executor evidence, deterministic QA, native Review bundle, rework or approval application, pending authorization, freshness projection, and completion all bind the same task-scoped digest and exact index bytes.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/kernel-r2c2-application.test.ts\",\n    \"tests/pi-canary-review-bundle.test.ts\",\n    \"tests/pi-canary-work-extension.test.ts\",\n    \"tests/pi-canary-user-authority.test.ts\",\n    \"tests/user-approval-tui-wiring.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 180000,\n  \"max_output_bytes\": 262144\n}\n"
