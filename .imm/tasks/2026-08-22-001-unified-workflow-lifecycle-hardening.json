  "intent_snapshot": {
    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "2026-08-22-001-unified-workflow-lifecycle-hardening",
    "goal": "Replace the fragmented Planner-to-terminal lifecycle with one authority-owned flow that closes all five approved post-mortem fixes. Add a recoverable pre-QA freeze operation that moves the immutable TaskIntent and the one exact Spec bound in scope_hint to archive paths and updates TaskRecord.intent_ref.path; securely reread actions from that path; atomically restore both artifacts before authorized rework; require completion to be frozen; and make stop archive before terminal settlement. Move the existing terminal 001, 005, and 006 sidecars and their completed Specs in the same migration. Require Planner reference closure across callers, focused tests, package copies, and same-state-machine owners before authoring, using ordinary module-directory scope but exact Kernel/security/migration paths. Make explicit Enrollment and Work Tool failures throw one parseable immune_brain/tool_failure/v1 error so Pi records isError=true while cancellation and awaiting-user remain ordinary outcomes. Resume an active Assurance owner with one bounded turn-local instruction that preserves original text/images instead of transforming every reply into /skill:imm-loop. Make Assurance projection and TaskRecord the sole dynamic status authority; keep prose for architecture and durable decisions only. Preserve foreground QA/Review, capability-bound user decisions, immutable byte/diff checks, terminal tombstones/claims, cancellation, and fail-closed recovery; add no background janitor, second writer, compatibility bridge, automatic commit, or successor TaskIntent.",
    "acceptance": [
      {
        "id": "acc-artifact-lifecycle",
        "assertion": "TaskIntent and its exact scope-bound Spec relocate through a recoverable freeze transaction; Kernel actions reread the current intent_ref.path; authorized rework restores both; complete requires frozen; stop always ends archived; and prior terminal 001, 005, and 006 planning artifacts are move-only archived without weakening terminal or archival invariants.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/kernel-canary-terminal-transaction.test.ts\",\n    \"tests/planning-artifact-archival.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 65536\n}\n"
      },
      {
        "id": "acc-planner-reference-closure",
        "assertion": "Source and packaged Planner contracts require bounded caller, test, package-copy, generated-mirror, and same-state-machine reference closure before TaskIntent authoring; ordinary modules use the smallest coherent directory scope while Kernel, authority, migration, secret, and security-sensitive paths remain exact.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/imm-planner-kernel-intent-contract.test.ts\",\n    \"tests/planner-settlement-contract.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 65536\n}\n"
      },
      {
        "id": "acc-host-tool-failures",
        "assertion": "Enrollment and Work Tools throw the same parseable immune_brain/tool_failure/v1 contract for explicit blocked, failed, authority-conflict, and settlement-unknown outcomes so Pi observes isError=true, while cancellation, waiver, review-ready, and awaiting-user control outcomes remain non-errors.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-enroll-extension.test.ts\",\n    \"tests/pi-canary-work-extension.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 65536\n}\n"
      },
      {
        "id": "acc-active-owner-resume",
        "assertion": "An input with an active Assurance owner preserves the user's original text and images and consumes one bounded turn-local owner instruction without /skill:imm-loop transformation or full Skill reinjection; terminal, repair, explicit Skill, Planner, Brainstorm, failure, settle, and shutdown paths clear or retain routing exactly as specified.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/managed-default-routing-contract.test.ts\",\n    \"tests/managed-task-routing-policy.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 65536\n}\n"
