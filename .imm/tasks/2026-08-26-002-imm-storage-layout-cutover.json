        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/kernel-canary-terminal-transaction.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 90000,\n  \"max_output_bytes\": 196608\n}\n"
      },
      {
        "id": "acc-automatic-layout-migration",
        "assertion": "The one-release migrator accepts only owner-free, transaction-free, affected-path-clean legacy layouts; holds old and new locks; freezes a hash manifest; relocates terminal and v3 machine evidence byte-for-byte; rejects unknown, symlinked, escaped, case-colliding, dirty, active, or conflicting inputs; recovers every interruption exactly; never mutates the Git index; stops the original mutation; and blocks retry until affected paths are committed.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/kernel-storage-layout-migration.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 262144\n}\n"
