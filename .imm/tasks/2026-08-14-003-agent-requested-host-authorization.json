  "intent_snapshot": {
    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "2026-08-14-003-agent-requested-host-authorization",
    "goal": "Let the parent Agent open the existing host-derived literal-user confirmation for the unique next canary authority wait, so users click one confirm dialog instead of typing /imm-canary-authorize and then confirming again, without accepting caller-supplied authority fields or changing native Review trust.",
    "acceptance": [
      {
        "id": "acc-closed-request-authorization-schema",
        "assertion": "The closed imm_kernel_canary tool exposes request_authorization as a no-argument orchestration op in addition to existing ordinary and assurance ops, while privileged reducer kinds remain structurally absent from the schema.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-work-extension.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 180000,\n  \"max_output_bytes\": 262144\n}\n"
      },
      {
        "id": "acc-host-derived-unique-confirm",
        "assertion": "request_authorization derives at most one existing authorize operation from the Kernel projection and session-local pending Review verdict, opens exactly one shared ctx.ui.confirm dialog whose summary is host-built, and on affirmation applies through the existing /imm-canary-authorize path without accepting operation, finding, approval, or capability fields from the caller.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-user-authority.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 180000,\n  \"max_output_bytes\": 262144\n}\n"
      },
      {
        "id": "acc-zero-write-authorization-failures",
        "assertion": "Cancel, timeout, abort, non-TUI, missing unique legal operation, and in-flight duplicate request_authorization paths perform zero Kernel writes and return only cancelled or blocked.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-user-authority.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 180000,\n  \"max_output_bytes\": 262144\n}\n"
      },
      {
        "id": "acc-skill-routes-to-request-authorization",
        "assertion": "Source and packaged imm-canary-work contracts instruct the Agent to call request_authorization after awaiting_user or a Review-ready follow-up, keep /imm-canary-authorize as the manual recovery surface, and do not tell the Agent to ask the user to type the authorize command as the primary path.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/imm-canary-work-contract.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 262144\n}\n"
      }
    ],
