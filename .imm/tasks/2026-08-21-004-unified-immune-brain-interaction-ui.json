    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "2026-08-21-004-unified-immune-brain-interaction-ui",
    "goal": "Unify Immune-Brain's host interaction surface without changing Kernel authority: add one bounded above-editor Task Rail driven only by existing Assurance projection and Tool/input lifecycle boundaries; publish a versioned process-local user-attention event around every literal-user Enrollment, waiver, breaking-revision, and Review authorization wait with finally-based cleanup; render Enrollment, Loop, Kernel, and terminal outcomes through a compact State / Result / Next hierarchy; deduplicate notifications so normal success, cancellation, and stage changes do not compete with persistent UI; and explicitly separate managed acceptance from unassessed repository health and best-effort Git state. Preserve the empty Footer, native Review, zero-write cancellation, no watcher/polling/timer/persistence invariants, and keep Herdr, pi-herdr-status, BEL, OS notifications, Pi core, and Kernel schemas out of scope.",
    "acceptance": [
      {
        "id": "acc-work-interaction-surface",
        "assertion": "Work and Assurance expose one bounded projection-fed Task Rail with terminal-until-next-input and shutdown cleanup, bracket Review and breaking-revision user waits with matching immune-brain:user-attention.v1 events across answer/cancel/abort/error paths, render Loop/Kernel/terminal outcomes as State / Result / Next, deduplicate warning/error notifications, separate acceptance from unassessed repository health and Git state, and leave Footer, polling, timers, persistence, native Review, and authority semantics unchanged.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-work-extension.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 65536\n}\n"
      },
      {
        "id": "acc-enrollment-attention-surface",
        "assertion": "Enrollment and explicit descriptor waiver display the same bounded task-level Rail and emit exactly one bounded immune-brain:user-attention.v1 open/close pair around validated literal-user UI, including decline, host abort, and UI failure cleanup, while event or Widget failures remain non-authoritative and no Herdr, BEL, external notification, Footer, watcher, polling, timer, or persisted UI path is introduced.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-enroll-extension.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 60000,\n  \"max_output_bytes\": 65536\n}\n"
      }
    ],
