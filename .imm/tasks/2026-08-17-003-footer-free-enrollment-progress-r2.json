    "contract": "assurance_kernel/task_intent/v1",
    "task_id": "2026-08-17-003-footer-free-enrollment-progress-r2",
    "goal": "Keep the Immune-Brain Footer empty in both runtime behavior and active documentation while presenting session-owned Enrollment preflight progress through one bounded aboveEditor Widget whose timer, cancellation, commit, and shutdown lifecycle cannot alter Kernel authority or the existing Host-native Assurance surfaces.",
    "acceptance": [
      {
        "id": "acc-footer-free-widget-contract",
        "assertion": "Enrollment and Assurance publish no defined-value ctx.ui.setStatus content at any lifecycle stage; both Enrollment commands remain non-blocking and share one bounded aboveEditor Widget that shows task, stage, elapsed time, and only the currently valid cancellation action, while cleanup-only setStatus(key, undefined) remains permitted solely for stale older-version UI.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-enrollment-progress-widget.test.ts\",\n    \"tests/pi-canary-enroll-extension.test.ts\",\n    \"tests/pi-canary-new-extension.test.ts\",\n    \"tests/pi-canary-assurance-observability.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 180000,\n  \"max_output_bytes\": 262144\n}\n"
      },
      {
        "id": "acc-widget-settlement-safety",
        "assertion": "Normal completion, preflight failure, user cancellation, confirmation rejection, commit success or failure, UI exceptions, and session shutdown stop every refresh timer and clear only the owning Widget; repeated or concurrent shutdown is idempotent, stale callbacks cannot affect a later job, cross-command single-flight remains deterministic, and no presentation signal settles or changes enrollment authority.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-enrollment-progress-widget.test.ts\",\n    \"tests/kernel-descriptor-rehearsal.test.ts\",\n    \"tests/pi-canary-enroll-extension.test.ts\",\n    \"tests/pi-canary-new-extension.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 180000,\n  \"max_output_bytes\": 262144\n}\n"
      },
      {
        "id": "acc-assurance-host-native-nonregression",
        "assertion": "Deterministic Assurance QA continues using bounded deduplicated notify updates without a custom Footer or Widget, Review remains visible through the standard Agent surface, cleanup-only stale UI removal remains best-effort, and Enrollment progress does not append Pi session entries, inject Chat messages, trigger model turns, or scan Session directories.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-assurance-observability.test.ts\",\n    \"tests/pi-canary-assurance-progression.test.ts\",\n    \"tests/pi-canary-work-extension.test.ts\",\n    \"tests/imm-canary-work-contract.test.ts\",\n    \"tests/pi-canary-packed-consumer.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 240000,\n  \"max_output_bytes\": 262144\n}\n"
      },
      {
        "id": "acc-footer-free-documentation",
        "assertion": "Active README guidance contains no Footer-based Immune-Brain progress claim and satisfies the current Bun plus TypeScript, v4 runtime, Pi-only host, and Pi package installation documentation contracts.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/python-reference-boundary.test.ts\",\n    \"tests/v4-runtime-launchers.test.ts\",\n    \"tests/pi-only-current-contracts.test.ts\",\n    \"tests/host-runtime-cutover.test.ts\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 180000,\n  \"max_output_bytes\": 262144\n}\n"
