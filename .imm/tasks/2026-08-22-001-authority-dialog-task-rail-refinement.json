        "id": "acc-work-shared-dialog",
        "assertion": "Review and every ordinary Work authorization use the same shared dialog shell; only Review rework and reject continue to native reason input; cancel, blank reason, abort, session drift, and UI error retain existing attention cleanup and zero-authority-write behavior.",
        "verification": "{\n  \"contract\": \"assurance_kernel/verification_descriptor/v1\",\n  \"runner_id\": \"bun\",\n  \"runner_version\": \"1.3.14\",\n  \"argv\": [\n    \"test\",\n    \"tests/pi-canary-work-extension.test.ts\",\n    \"-t\",\n    \"shared-authority-dialog-shell\"\n  ],\n  \"cwd\": \".\",\n  \"timeout_ms\": 120000,\n  \"max_output_bytes\": 65536\n}\n"
      },
