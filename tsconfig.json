{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2023"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": false,
		"forceConsistentCasingInFileNames": true,
		"types": [
			"bun"
		]
	},
	"include": [
		"plugins/immune-brain/runtime/**/*.ts",
		"plugins/immune-brain/.pi-extension/**/*.ts",
		"plugins/immune-brain/skills/**/*.ts",
		"scripts/**/*.ts",
		"types/**/*.d.ts"
	],
	"exclude": [
		"node_modules",
		"plugins/immune-brain/dist"
	]
}
