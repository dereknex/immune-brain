#!/bin/sh
set -eu

# ─────────────────────────────────────────────────────────────────────────────
# imm-pr-diag — Collect PR diagnostic data and emit a single JSON report
# ─────────────────────────────────────────────────────────────────────────────
# This is a STANDALONE script. It does NOT depend on Python or
# immune_brain_runtime.py.  It requires only `gh` (GitHub CLI) and `jq`.
# ─────────────────────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
Usage: $(basename "$0") <PR>

Collect diagnostic data for a GitHub pull request and output a single JSON
object to stdout.

Arguments:
  <PR>    Pull request identifier — a number, URL, or branch name.

Options:
  -h, --help    Show this help message and exit.

Prerequisites:
  • gh   — GitHub CLI (https://cli.github.com)
  • jq   — Command-line JSON processor (https://stedolan.github.io/jq)

Output:
  A JSON object containing pr_target, checks, reviews, review_threads,
  comments, conflicts, and blocker_summary fields. Unknown mergeability and
  pending checks remain explicit; any failed diagnostic query exits nonzero.
EOF
  exit 0
}

# ── Argument handling ────────────────────────────────────────────────────────

if [ $# -eq 0 ]; then
  usage
fi

case "${1:-}" in
  -h|--help) usage ;;
esac

PR="$1"

# ── Dependency checks ───────────────────────────────────────────────────────

if ! command -v gh >/dev/null 2>&1; then
  echo "error: 'gh' (GitHub CLI) is required but not found in PATH." >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "error: 'jq' is required but not found in PATH." >&2
  exit 1
fi

# ── Fetch PR metadata ───────────────────────────────────────────────────────

PR_JSON=$(gh pr view "$PR" --json number,headRefName,headRefOid,headRepository,headRepositoryOwner,baseRefName,url,mergeable,mergeStateStatus,files 2>&1) || {
  echo "error: failed to fetch PR data for '${PR}'. Is this a valid PR identifier?" >&2
  echo "       gh output: ${PR_JSON}" >&2
  exit 1
}

PR_NUMBER=$(printf '%s\n' "$PR_JSON" | jq -er '.number')
PR_HOST=$(printf '%s\n' "$PR_JSON" | jq -er '.url | split("/")[2]')
REPO_FULL_NAME=$(printf '%s\n' "$PR_JSON" | jq -er '.url | split("/")[3:5] | join("/")')
TARGET_REPO="$PR_HOST/$REPO_FULL_NAME"

# ── Fetch CI checks ─────────────────────────────────────────────────────────

CHECKS_STATUS=0
CHECKS_JSON=$(gh pr checks "$PR_NUMBER" --repo "$TARGET_REPO" --json name,state,bucket,link,workflow 2>&1) || CHECKS_STATUS=$?
# gh uses 1 for failed checks and 8 for pending checks; both carry valid JSON.
if { [ "$CHECKS_STATUS" -ne 0 ] && [ "$CHECKS_STATUS" -ne 1 ] && [ "$CHECKS_STATUS" -ne 8 ]; } ||
   ! printf '%s\n' "$CHECKS_JSON" | jq -e 'type == "array"' >/dev/null 2>&1; then
  echo "error: failed to fetch PR checks for '${PR}'." >&2
  echo "       gh output: ${CHECKS_JSON}" >&2
  exit 1
fi

# ── Fetch reviews ───────────────────────────────────────────────────────────

REVIEWS_PAGES=$(gh api --hostname "$PR_HOST" --paginate --slurp "repos/$REPO_FULL_NAME/pulls/$PR_NUMBER/reviews" 2>&1) || {
  echo "error: failed to fetch PR reviews: $REVIEWS_PAGES" >&2
  exit 1
}
REVIEWS_JSON=$(printf '%s\n' "$REVIEWS_PAGES" | jq '[.[][]]')
COMMENTS_PAGES=$(gh api --hostname "$PR_HOST" --paginate --slurp "repos/$REPO_FULL_NAME/issues/$PR_NUMBER/comments" 2>&1) || {
  echo "error: failed to fetch PR comments: $COMMENTS_PAGES" >&2
  exit 1
}
COMMENTS_JSON=$(printf '%s\n' "$COMMENTS_PAGES" | jq '[.[][]]')

# ── Fetch review threads (comments) ─────────────────────────────────────────

REPO_OWNER=${REPO_FULL_NAME%/*}
REPO_NAME=${REPO_FULL_NAME#*/}
THREADS_PAGES=$(gh api --hostname "$PR_HOST" graphql --paginate --slurp \
  -f owner="$REPO_OWNER" \
  -f repo="$REPO_NAME" \
  -F pr="$PR_NUMBER" \
  -f query='
query($owner: String!, $repo: String!, $pr: Int!, $endCursor: String) {
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $pr) {
      reviewThreads(first: 100, after: $endCursor) {
        nodes {
          id
          path
          line
          startLine
          isResolved
          isOutdated
          viewerCanResolve
          comments(first: 100) {
            nodes {
              id
              url
              author { login }
              body
              createdAt
              updatedAt
            }
            totalCount
          }
        }
        pageInfo {
          hasNextPage
          endCursor
        }
      }
    }
  }
}
' 2>&1) || {
  echo "error: failed to fetch PR review threads for '${PR}'." >&2
  echo "       gh output: ${THREADS_PAGES}" >&2
  exit 1
}
THREADS_JSON=$(printf '%s\n' "$THREADS_PAGES" | jq -e '
  if any(.[]; (.errors | length) > 0 or .data.repository.pullRequest == null)
  then error("incomplete review thread response")
  else [.[].data.repository.pullRequest.reviewThreads.nodes[]] end')

# Fetch overflowing discussions separately so both connection cursors stay complete.
THREADS_JSON=$(printf '%s\n' "$THREADS_JSON" | jq -c '.[]' | while IFS= read -r thread; do
  if [ "$(printf '%s\n' "$thread" | jq -r '.comments.totalCount > 100')" = true ]; then
    thread_id=$(printf '%s\n' "$thread" | jq -r '.id')
    pages=$(gh api --hostname "$PR_HOST" graphql --paginate --slurp -f id="$thread_id" -f query='
query($id: ID!, $endCursor: String) {
  node(id: $id) {
    ... on PullRequestReviewThread {
      comments(first: 100, after: $endCursor) {
        nodes { id url author { login } body createdAt updatedAt }
        pageInfo { hasNextPage endCursor }
      }
    }
  }
}' 2>&1) || {
      echo "error: failed to fetch discussion $thread_id: $pages" >&2
      exit 1
    }
    comments=$(printf '%s\n' "$pages" | jq -e '
      if any(.[]; (.errors | length) > 0 or .data.node == null)
      then error("incomplete discussion response")
      else [.[].data.node.comments.nodes[]] end') || exit 1
    printf '%s\n' "$thread" | jq --argjson comments "$comments" '.comments.nodes = $comments' || exit 1
  else
    printf '%s\n' "$thread"
  fi
done) || exit 1
THREADS_JSON=$(printf '%s\n' "$THREADS_JSON" | jq -s '.')

# ── Assemble the final JSON ─────────────────────────────────────────────────

jq -n \
  --argjson pr "$PR_JSON" \
  --argjson checks "$CHECKS_JSON" \
  --argjson reviews "$REVIEWS_JSON" \
  --argjson threads "$THREADS_JSON" \
  --argjson comments "$COMMENTS_JSON" \
'
# ── pr_target ──────────────────────────────────────────────────────────────
($pr.mergeable // "UNKNOWN") as $mergeable |
($reviews | sort_by(.submitted_at, .id) | group_by(.user.login)
  | map(map(select(.state != "COMMENTED" and .state != "PENDING")) | last)
  | map(select(. != null))) as $decisions |

{
  pr_target: {
    number:    $pr.number,
    repository: ($pr.url | split("/")[3:5] | join("/")),
    head_repository: (if $pr.headRepository == null then null else
      ($pr.headRepositoryOwner.login + "/" + $pr.headRepository.name) end),
    head_sha:  $pr.headRefOid,
    branch:    $pr.headRefName,
    base:      $pr.baseRefName,
    url:       $pr.url,
    mergeable: $mergeable
  },

# ── checks ─────────────────────────────────────────────────────────────────
  checks: [
    $checks[] | {
      name:       .name,
      status:     .state,
      bucket:     (.bucket // null),
      conclusion: (.bucket // .state),
      url:        (.link // null),
      workflow:   (.workflow // null)
    }
  ],

# Keep review bodies and chronology; later COMMENTED reviews do not revoke decisions.
  reviews: [
    $reviews[] | {
      id: .id, url: .html_url, author: .user.login,
      state: .state, body: (.body // ""),
      submitted_at: .submitted_at, commit_id: .commit_id
    }
  ],
  comments: [
    $comments[] | {
      id: .id, url: .html_url, author: .user.login,
      body: (.body // ""), created_at: .created_at, updated_at: .updated_at
    }
  ],

# ── review_threads ─────────────────────────────────────────────────────────
  review_threads: [
    $threads[] | {
      id: .id,
      path: .path,
      line: (.line // .startLine // null),
      body: (.comments.nodes[0].body // ""),
      comments: .comments.nodes,
      isResolved: .isResolved,
      isOutdated: .isOutdated,
      viewerCanResolve: .viewerCanResolve
    }
  ],

# ── conflicts ──────────────────────────────────────────────────────────────
  conflicts: (
    (if $mergeable == "CONFLICTING" then true
     elif $mergeable == "MERGEABLE" then false else null end) as $has |
    {
      has_conflicts:    $has,
      conflicting_files_status: (
        if $has == false then "none" else "unknown" end
      ),
      conflicting_files: []
    }
  ),

# ── blocker_summary (computed) ─────────────────────────────────────────────
  blocker_summary: (
    # Failing checks
    [ $checks[] | select(.bucket == "fail" or .state == "FAILURE" or .state == "ACTION_REQUIRED") | .name ] as $failing |

    # Unresolved review threads
    [ $threads[] | select(.isResolved == false) ] | length as $pending |

    [$decisions[] | select(.state == "CHANGES_REQUESTED") | .id] as $requested |
    [$checks[] | select(.bucket == "pending") | .name] as $waiting |
    (if $mergeable == "CONFLICTING" then true
     elif $mergeable == "MERGEABLE" then false else null end) as $has_conflicts |

    # Categories
    (
      (if ($failing | length) > 0     then ["check_repair"]    else [] end) +
      (if $pending > 0 or ($requested | length) > 0 then ["feedback_repair"] else [] end) +
      (if $has_conflicts              then ["conflict_repair"]  else [] end)
    ) as $cats |

    {
      failing_checks:       $failing,
      pending_feedback_count: ($pending + ($requested | length)),
      pending_thread_count: $pending,
      changes_requested_review_ids: $requested,
      pending_checks: $waiting,
      mergeability_unknown: ($has_conflicts == null),
      has_merge_conflicts: $has_conflicts,
      blocker_categories:   $cats
    }
  )
}
'
