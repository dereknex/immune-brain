{
  "immune-brain": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node \"./dist/antigravity/mcp-server.mjs\" --hook"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|invoke_subagent|Subagent|call_mcp_tool|mcp__.*immune-brain.*__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"./dist/antigravity/mcp-server.mjs\" --hook",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "invoke_subagent|Subagent|call_mcp_tool|mcp__.*immune-brain.*__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"./dist/antigravity/mcp-server.mjs\" --hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node \"./dist/antigravity/mcp-server.mjs\" --hook"
      }
    ]
  }
}
